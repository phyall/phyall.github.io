{% assign pages = site.msc_alumni | sort: "title" %}
{% for p in pages reversed %}
  <a class="year-badge" href="{{ p.url | relative_url }}">
    {{ p.year }}
  </a>
{% endfor %}


{% for symposium in site.data.symposium %}

{% if symposium.status == "past" %}

<p>
{{ symposium.date }}
&nbsp;&nbsp;
<a href="{{ site.baseurl }}/assets/pdfs/symposiums/{{ symposium.date }}.pdf"
   target="_blank"
   class="badge">Details</a>
</p>

{% endif %}

{% endfor %}
